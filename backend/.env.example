# Application Settings
PROJECT_NAME="IRIS - IUT Repository and Information System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="change_this_to_a_super_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=["*"]

# Google OAuth (@iut-dhaka.edu domain restriction)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
ALLOWED_EMAIL_DOMAIN="iut-dhaka.edu"

# Database (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://iris_user:iris_password@localhost:5432/iris_db"

# Storage (Cloudflare R2 / AWS S3 / Local)
STORAGE_PROVIDER="local" # "r2" | "s3" | "local"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="iris-documents"
S3_PUBLIC_URL_PREFIX="http://localhost:8000/uploads"

# AI / LLM (Google Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# OCR Settings
TESSERACT_CMD_PATH="" # Leave blank if in system PATH
